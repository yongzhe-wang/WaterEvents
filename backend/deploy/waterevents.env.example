# WaterEvents discovery worker — runtime env template.
# Copy to ~/.waterevents.env on the GCE worker VM, fill the secrets, then run: bash deploy/run_discovery.sh
# WHY a sourced env file (not flags on the command line): keeps the RunPod key + DB DSN out of shell history / ps output.

# ── VLM (RunPod, OpenAI-compatible) ──
# The RunPod HTTP proxy for the pod's port 8000. Requires port 8000 EXPOSED + vLLM bound --host 0.0.0.0.
export QWEN_BASE_URLS="https://<podid>-8000.proxy.runpod.net/v1"
export QWEN_API_KEY="sk-waterevents-..."            # the --api-key the pod's vLLM was launched with
export QWEN_SERVED_NAME="qwen-vl"                    # MUST equal the pod's --served-model-name or every request 404s
# ⚠️ THESE MUST FIT THE POD'S --max-model-len. The no-chunking extract path (2026-07-23) sends the FULL inline text +
# the screenshot in ONE call → the pod MUST be --max-model-len 32768 (NOT 16384). Budget on a 32768 ctx: image ~1.5k tok
# (client pixel-bounds it) + text ~7k (24000 chars) + system ~1k + OUTPUT ≤8k ≈ 17.5k < 32768. {EXTRACT.PY 2026-07-23
# "SEND THE FULL inline text + the screenshot in ONE call, and SCALE the server (--max-model-len 32768) + output"}.
# If the pod is still 16384, LOWER EVENT_VISION_TEXT_CHARS + QWEN_MAX_TOKENS to fit, or output truncates → FAIL LOUD.
export QWEN_MAX_TOKENS="8192"

# ── crawl knobs ──
# Vision path text cap. 24000 = the no-chunking default: a normal rich IR page (coca-cola/apple ≈ 11-15k inline chars)
# is NEVER trimmed, so its SCREENSHOT is ALWAYS kept (dropping the shot → the model bags junk nav links + under-extracts).
# {EXTRACT.PY: "8000 was catastrophically low — it trimmed normal pages into the shot-dropping chunk path"}. Needs pod 32768.
export EVENT_VISION_TEXT_CHARS="24000"
export EVENT_MAX_PAGES="60"                          # BFS page cap per company (60 = a full IR tree)
export EVENT_USE_IMAGE="1"                            # send the screenshot to the VL model (the whole point)

# ── DB (Supabase Supavisor transaction pooler, port 6543) ──
# The discovery worker claims companies + batch-flushes events here. Transaction-mode pooler multiplexes connections so
# many workers don't exhaust Postgres. db.py forces statement_cache_size=0 (transaction mode has no prepared statements).
export WATEREVENTS_DB_DSN="postgresql://postgres.<ref>:<pw>@aws-1-us-east-1.pooler.supabase.com:6543/postgres"
export WATEREVENTS_RUN_ID="run-$(date +%Y%m%d)"      # groups one full batch run (completion-barrier scopes to this)

# ── residential proxy (Webshare rotating gateway) ──
# Arms runtime._browser_proxy so the tier-2 RESIDENTIAL render lane can fire. UNSET = tier DORMANT: every bot-walled /
# IP-tarpitted host (the 7+ gcs-web.com / Q4 Inc. IR pages that read-timeout from datacenter egress) is NEVER retried
# through a residential IP → permanent 0-events for those companies. ALL THREE must be set or webshare.playwright_proxy()
# returns None and the tier-2 gate `if runtime._browser_proxy is not None` is always False.
# {AUDIT 2026-07-24 residential_channel: env.example had ZERO WEBSHARE_* exports → residential tier never fired in any pod
# run; WEBSHARE/__INIT__.PY:47 "IF NOT (_USER AND _PW AND _PROXIES): RETURN ''"} [CONFIDENCE: CONFIRMED — grep of this
# file for WEBSHARE returned empty; residential is the ONLY channel that can save the gcs-web tarpit, currently unarmed].
export WEBSHARE_USERNAME="<user>-rotate"   # rotating gateway username (the -rotate suffix variant); from Secret Manager
export WEBSHARE_PASSWORD="<pw>"            # proxy password (shared with the static plan); from Secret Manager
export WEBSHARE_PROXIES="p.webshare.io:80" # the single rotating gateway host (gateway rotates residential IPs server-side)
# OR, instead of the three vars above, a single full proxy url (WINS if set) — a STATIC residential endpoint from the plan:
# export WEBSHARE_PROXY="http://<user>:<pw>@<ip>:<port>"   # e.g. one of the 20 static residential ip:port in the plan
# ⚠️ tier-4 camoufox (the ONLY lane that beats FULL Akamai/Incapsula sensor.js — recovered tesla/homedepot/nestle) needs
# BOTH (a) a proxy set above AND (b) the Firefox system libs (libgtk-3-0 …). onstart.sh + supervise_workers.sh preflight
# now apt-install those libs; on a bare pod without them, camoufox launch dies "Couldn't load XPCOM" and tier4 is DORMANT.
# {AUDIT 2026-07-24: proxy set + libgtk installed → rewall recovered 39/45 walls (98.3%→99.8%)}.
