# janitor — bound the crawl-trace directory so disk cannot fill silently.
#
# 用一句话讲完: 每天保留最新 500 个 trace 目录, 其余删掉 —— 因为每次 crawl 都会写一个完整审计目录, 无人清理时它
# 单调增长, 而磁盘写满的表现是 fleet 莫名卡死, 不是一条清晰的 "disk full" 报错。
#
# LANDED FROM THE HOST 2026-07-29. This unit has been RUNNING in production while existing in no committed file: the
# installer that created it (backend/deploy/install_systemd.sh) was deleted during a consolidation, and
# systemd/install.sh — which claims to be the only installer — references this filename without the file ever having
# been committed. `set -euo pipefail` plus `install -m 644 <missing>` meant that installer aborted at that line, so
# there was no runnable install path at all while production kept working off the units the deleted script had left
# behind. Recovered verbatim from /etc/systemd/system so repo and host finally agree.
# {SHELL 2026-07-29 "git log --all --diff-filter=AD -- '*janitor*' → empty (never committed)"}
# {INSTALL.SH:80 "\"$SRC/WATEREVENTS-JANITOR.SERVICE\"  \"$SRC/WATEREVENTS-JANITOR.TIMER\" /ETC/SYSTEMD/SYSTEM/"}
# [CONFIDENCE: CONFIRMED 100% — content copied from the live host via `systemctl cat`; the absence from git history was
#  checked with --diff-filter=AD across all refs.]
#
# Upstream trigger: waterevents-janitor.timer (daily). Downstream: deletes trace directories only — never touches the DB.
[Unit]
Description=WaterEvents trace retention (keep newest 500 crawl traces)

[Service]
Type=oneshot
User=thebigsun
# THE LOGIC IS IN A SCRIPT, DELIBERATELY. Two different inline ExecStart one-liners were silently rewritten by systemd
# before this unit ever reached a shell: the inner double quotes around "$T" terminate systemd's quoted-string parsing,
# so the stored command truncated to `argv[]=/bin/bash -c set -o pipefail` — set an option, exit 0, report success in
# one second. `%` is also systemd's specifier prefix, so find's `-printf "%T@ %p"` cannot safely be written here at all,
# and `\t` / `\0` are consumed by systemd's escape processing before bash sees them. A file is run by a shell, so none
# of that applies to it; deploy/reaper.sh and deploy/watchdog.sh are files for the same reason.
# {JOURNAL 2026-08-01 "Ignoring unknown escape sequences: \"set -o pipefail; T=...\""}
# {SYSTEMCTL 2026-08-01 "systemctl show -p ExecStart" -> "argv[]=/bin/bash -c set -o pipefail"}
# [CONFIDENCE: CONFIRMED 100% — the truncated argv was read back out of systemd after installing the one-liner.]
ExecStart=/home/thebigsun/WaterEvents/backend/deploy/janitor.sh
